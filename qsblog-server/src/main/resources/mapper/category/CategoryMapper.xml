<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.charqe.qs.modules.category.domain.dao.CategoryMapper">

    <resultMap id="ArticleCategoryNameDTO" type="io.charqe.qs.modules.category.controller.web.dto.ArticleCategoryNameDTO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="selectBatchIdsWithNames" resultMap="ArticleCategoryNameDTO">
        SELECT id, name FROM category WHERE is_del = 0 AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
