<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.charqe.qs.modules.tag.domain.dao.TagMapper">

    <resultMap id="ArticleTagNameDTO" type="io.charqe.qs.modules.tag.controller.web.dto.ArticleTagNameDTO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="selectBatchIdsWithNames" resultMap="ArticleTagNameDTO">
        SELECT id, name FROM tag WHERE is_del = 0 AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
